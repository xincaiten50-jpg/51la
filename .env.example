# Notification method: gmail | wecom | both
NOTIFICATION_METHOD=gmail
EMAIL_LANG=zh

# WeCom
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
WECOM_SEND_DELAY_SECONDS=1.0

# Gmail / Google Workspace SMTP
# SMTP_PROVIDER: gmail | workspace_relay | exmail (legacy QQ)
SMTP_PROVIDER=gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_AUTH_REQUIRED=true

# Sender
SMTP_SENDER=report@your-company.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD_OR_WORKSPACE_SMTP_SECRET

# Recipients - Vietnamese
SMTP_TO_VI=recipient_vi@example.com
SMTP_CC_VI=cc1@example.com,cc2@example.com

# Recipients - Chinese
SMTP_TO_ZH=recipient_zh@example.com
SMTP_CC_ZH=cc1@example.com,cc2@example.com

# 51.la scraper
# Comma-separated URLs in F,G,H,I order
SCRAPER_LINKS=https://v6.51.la/s/YOUR_LINK_F,https://v6.51.la/s/YOUR_LINK_G,https://v6.51.la/s/YOUR_LINK_H,https://v6.51.la/s/YOUR_LINK_I
SCRAPER_PASSWORD=YOUR_51LA_PASSWORD

# Excel
EXCEL_PATH=51la.xlsx
SHEET_NAME=Sheet1

# Monthly workbook (pre-created files in reports/ directory)
# Set USE_PRECREATED_MONTHLY_FILES=true to use pre-created monthly workbooks
USE_PRECREATED_MONTHLY_FILES=false
# Set AUTO_CREATE_MONTHLY_WORKBOOK=true only if you want auto-creation (not recommended)
AUTO_CREATE_MONTHLY_WORKBOOK=false
REPORTS_DIR=reports
REPORT_FILE_PATTERN=51la_{YYYY-MM}.xlsx
CURRENT_WORKBOOK_PATH=51la_current.xlsx
COPY_TO_CURRENT=true

# Legacy single workbook (default: 51la.xlsx)
# EXCEL_PATH=51la.xlsx

# Schedule
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=50
TIMEZONE=Asia/Ho_Chi_Minh

# Machine names (comma-separated, 4 values)
MACHINE_NAMES=11-02-01,11-02-02,11-02-03,11-02-04

# Real email safety — MUST be false for dry-run / code testing
ALLOW_REAL_EMAIL_SEND=false

# Debug
SMTP_DEBUG=0